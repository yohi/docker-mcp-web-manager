# Fast Build - 実用的な高速化アプローチ
# 戦略: 開発依存関係除外 + 最小ビルドセット + better-sqlite3ビルド最適化

FROM node:20-alpine AS development

WORKDIR /app

# システム依存関係のインストール
RUN apk add --no-cache \
    libc6-compat \
    dumb-init \
    curl \
    sqlite \
    gcompat \
    python3 \
    make \
    g++

# package.jsonをコピー
COPY package*.json ./

# プロダクション依存関係のみをインストール (開発依存関係を除外)
# better-sqlite3は自動でビルドされる
RUN npm ci --only=production --legacy-peer-deps --no-audit --no-fund

# 開発に最低限必要な依存関係のみを追加インストール
RUN npm install --no-save \
    next@15.5.2 \
    typescript@5.0.0 \
    @types/node@22.0.0 \
    --legacy-peer-deps

# アプリケーションファイルをコピー
COPY . .

# 環境設定
RUN cp .env.example .env.local

# 権限設定
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p /app/data && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

USER nextjs
EXPOSE 3000

ENV NODE_ENV=development

# 開発サーバー起動
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]