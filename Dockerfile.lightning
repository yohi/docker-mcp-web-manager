# Lightning Fast Build - プリビルトバイナリ最適化
# 戦略: better-sqlite3プリビルトバイナリ + 最小ビルド + 積極キャッシング

FROM node:20-alpine AS development

WORKDIR /app

# 基本パッケージ (キャッシュされる)
RUN apk add --no-cache \
    libc6-compat \
    dumb-init \
    curl \
    sqlite \
    gcompat \
    wget

# package.json をコピー (依存関係キャッシングのため)
COPY package*.json ./

# 高速インストール戦略
# 1. プリビルドバイナリを優先
# 2. ビルドスクリプトをスキップ
# 3. オプション依存関係を無視
RUN npm ci --legacy-peer-deps --prefer-offline --no-audit --no-fund --ignore-scripts --no-optional || \
    # フォールバック: forceインストール
    npm install --legacy-peer-deps --force --no-audit --no-fund --ignore-scripts --no-optional

# better-sqlite3の修復(プリビルトバイナリが利用可能な場合)
RUN npm rebuild better-sqlite3 --silent || \
    # プリビルトバイナリをダウンロード
    (cd node_modules/better-sqlite3 && \
     wget -q https://github.com/WiseLibs/better-sqlite3/releases/download/v11.0.0/better-sqlite3-v11.0.0-node-v115-linux-x64-musl.tar.gz -O prebuilt.tar.gz && \
     tar -xzf prebuilt.tar.gz || true) || \
    echo "Using installed better-sqlite3"

# アプリケーションファイルをコピー
COPY . .

# 環境設定
RUN cp .env.example .env.local

# 権限設定
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p /app/data && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

USER nextjs
EXPOSE 3000

ENV NODE_ENV=development

# 開発サーバー起動
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]