# 最適化済み Ubuntu→Alpine マルチステージビルド
# better-sqlite3を維持しつつビルド時間を大幅短縮

# Stage 1: Ubuntu環境でbetter-sqlite3のみを最速ビルド
FROM node:20-bookworm-slim AS sqlite-builder

WORKDIR /app

# better-sqlite3ビルドに必要な最小限のパッケージ
RUN apt-get update && apt-get install -y \
    python3 make g++ sqlite3 ca-certificates \
    --no-install-recommends && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# package.jsonとlockfileをコピー
COPY package*.json ./

# better-sqlite3のみをビルド（高速化のため単体で実行）
RUN npm install better-sqlite3@11.0.0 --no-save --legacy-peer-deps

# Stage 2: Alpine環境で残りの依存関係とアプリケーション実行
FROM node:20-alpine AS development

WORKDIR /app

# Alpineランタイム依存関係
RUN apk add --no-cache --virtual .runtime-deps \
    libc6-compat \
    dumb-init \
    curl \
    sqlite \
    gcompat

# package.json をコピー
COPY package*.json ./

# better-sqlite3を除いた依存関係を高速インストール
# ignore-scriptsでポストインストールスクリプトをスキップ
RUN npm ci --legacy-peer-deps --no-audit --no-fund --ignore-scripts

# Ubuntu環境でビルドしたbetter-sqlite3をコピー
COPY --from=sqlite-builder /app/node_modules/better-sqlite3 ./node_modules/better-sqlite3

# アプリケーションファイルをコピー
COPY . .

# 環境設定
RUN cp .env.example .env.local

# 権限設定
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p /app/data && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

USER nextjs
EXPOSE 3000

ENV NODE_ENV=development

# 開発サーバー起動
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]