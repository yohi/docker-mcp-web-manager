# 簡素化されたDockerfile - ローカルビルドを利用

FROM node:18-alpine AS development

WORKDIR /app

# 軽量なランタイム依存関係をインストール
RUN apk add --no-cache \
    libc6-compat \
    dumb-init \
    curl \
    sqlite

# ローカルの既存node_modulesと全ファイルをコピー
COPY . .

# 環境設定ファイルを準備
RUN cp .env.example .env.local

# nodeユーザーでデータディレクトリを作成
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p /app/data && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

# セキュリティ強化
USER nextjs

EXPOSE 3000

# 開発サーバーを起動
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]