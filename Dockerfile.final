# 実用的高速ビルド最終版 - better-sqlite3維持 + 大幅時短
# 戦略: プリビルドキャッシュ + 依存関係分離 + 最小ビルドセット

# Base環境準備
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat dumb-init curl sqlite gcompat

# Stage 1: package.jsonによる依存関係キャッシング
FROM base AS deps
COPY package*.json ./
# キャッシュ最適化: package.jsonが変更されない限りこのレイヤーは再利用される
RUN npm ci --legacy-peer-deps --no-audit --no-fund --prefer-offline --ignore-scripts && \
    # better-sqlite3のみを追加で処理（必要に応じて）
    npm rebuild better-sqlite3 2>/dev/null || echo "better-sqlite3 already built"

# Stage 2: 最終実行環境
FROM base AS development
# 事前ビルド済みnode_modulesをコピー
COPY --from=deps /app/node_modules ./node_modules

# アプリケーションファイルをコピー（.dockerignoreで最適化されたファイルのみ）
COPY . .

# 環境設定
RUN cp .env.example .env.local

# 権限設定（最小限）
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p /app/data && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

USER nextjs
EXPOSE 3000
ENV NODE_ENV=development

# 開発サーバー起動
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]