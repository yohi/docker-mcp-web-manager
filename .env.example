# =================================================================
# Docker MCP Web Manager v2 - 環境変数設定例
# Copy this file to .env.local for development or .env for production
# =================================================================

# ===== Web Application Settings =====
WEB_PORT=3000
WEB_DEV_PORT=3003
NODE_ENV=development

# ===== Database Settings =====
DATABASE_URL=file:/usr/src/app/data/app.db
DATA_PATH=./data

# ===== Authentication Settings =====
NEXTAUTH_SECRET=your-secret-key-32-characters-long
NEXTAUTH_URL=http://localhost:3000
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-this-password
SKIP_AUTH=false

# ===== Security Settings =====
CORS_ORIGIN=http://localhost:3000
ENCRYPTION_MASTER_KEY=your-encryption-master-key-32-chars

# ===== Redis Settings =====
REDIS_PORT=6379
REDIS_DEV_PORT=6381

# ===== Nginx Settings (Production) =====
NGINX_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# Rate Limiting & Security Configuration
# =============================================================================

# レート制限設定
SERVER_RATE_USER_RPM=1000

# Server-Sent Events (SSE) 設定
SERVER_SSE_HEARTBEAT_INTERVAL=30000
SERVER_SSE_CLIENT_TIMEOUT=60000
SERVER_SSE_MAX_CONNECTIONS=100
SERVER_SSE_MAX_LINE_LENGTH=10240
SERVER_SSE_RATE_LIMIT=100
SERVER_SSE_MEMORY_CAP=52428800
SERVER_SSE_PAGE_SIZE=1000

# =============================================================================
# Logging & Monitoring Configuration
# =============================================================================

# ログ設定
SERVER_LOG_RETENTION_DAYS=30
SERVER_LOG_ROTATION_SIZE=104857600
SERVER_LOG_ROTATION_INTERVAL=daily

# =============================================================================
# Authentication Configuration
# =============================================================================

# JWT Secret（32文字以上の強固なキーを設定）
JWT_SECRET=your-jwt-secret-key-change-in-production-with-strong-key

# デフォルト管理者アカウント（開発・初回セットアップ用）
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# 認証スキップ（開発時のみ、本番では必ずfalse）
SKIP_AUTH=false

# =============================================================================
# Bitwarden Integration Configuration
# =============================================================================

# Bitwarden認証の有効化
ENABLE_BITWARDEN_AUTH=true

# Bitwardenサーバー設定
BITWARDEN_SERVER_URL=https://vault.bitwarden.com

# Bitwarden管理者メールアドレス（カンマ区切りで複数指定可能）
BITWARDEN_ADMIN_EMAILS=admin@example.com

# Bitwarden API認証情報（オプション：API経由認証の場合）
# BITWARDEN_CLIENT_ID=your-client-id
# BITWARDEN_CLIENT_SECRET=your-client-secret

# Bitwarden Organization ID（オプション：組織管理の場合）
# BITWARDEN_ORGANIZATION_ID=your-org-id

# =============================================================================
# Development & Testing Configuration
# =============================================================================

# 開発時のDebug設定
DEBUG=false
LOG_LEVEL=info

# テスト環境設定
TEST_DATABASE_URL=file:/app/data/test.db