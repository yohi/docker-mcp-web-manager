# キャッシュを活用した実践的Dockerfile

# Stage 1: Dependencies builder (Ubuntu base for better compatibility)
FROM node:20-bookworm-slim AS deps

WORKDIR /app

# ビルド用パッケージをインストール
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# package.json をコピー
COPY package*.json ./

# better-sqlite3をビルド（Ubuntu環境で成功率向上）
RUN npm ci --legacy-peer-deps

# Stage 2: Production runtime (Alpine for smaller size)
FROM node:20-alpine AS development

WORKDIR /app

# ランタイム依存関係をインストール
RUN apk add --no-cache \
    libc6-compat \
    dumb-init \
    curl \
    sqlite \
    gcompat

# Ubuntu環境でビルドしたnode_modulesをコピー
COPY --from=deps /app/node_modules ./node_modules

# アプリケーションファイルをコピー
COPY . .

# 環境設定ファイルを準備
RUN cp .env.example .env.local

# 権限設定
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p /app/data && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

USER nextjs
EXPOSE 3000

ENV NODE_ENV=development

# 開発サーバーを起動
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]